#!/usr/bin/env bash
# vim:ft=bash
#
# Author: https://github.com/Astatoru
# Name: extract
# Description: Wrapper script for pkg extractor tool (https://github.com/AzaharPlus/shadPS4Plus)
# Dependencies: extractor.AppImage

# Strict error handling
set -euo "pipefail"

# Array that holds specified packages
declare -a ENTRIES=()
# Directory with games
# Settings > Configure > Paths > Game Folders
declare GAMES=""
# Directory with DLCs
# Settings > Configure > Paths > DLC Path
declare ADDONS=${ADDONS:-$HOME/.local/share/shadPS4/addcont}
# Path to extractor AppImage
declare EXTRACTOR="${EXTRACTOR:-./extractor.AppImage}"

# Display info messages
info() {
    local MESSAGE="$1"
    if [[ -t 1 ]]; then
        printf "%b\n" "\033[01;34mINFO\033[0m: $MESSAGE"
    else
        printf "%s\n" "INFO: $MESSAGE"
    fi
}

# Display error messages
error() {
    local MESSAGE="$1"
    if [[ -t 2 ]]; then
        >&2 printf "%b\n" "\033[01;31mERROR\033[0m: $MESSAGE"
    else
        >&2 printf "%s\n" "ERROR: $MESSAGE"
    fi
}

# Help message
help() {
    cat <<EOF
Usage:
    ${0##*/} [OPTIONS] PACKAGE [PACKAGE...]

Options:
    -h, --help                Show this help message
    -g, --games-directory     Path to directory with games (Default: None)
    -a, --addons-directory    Path to directory with DLCs (Default: $ADDONS)
EOF
}

# Check if script is run as root
checkRoot() {
    if ((EUID == 0)); then
        error "Please do not run this script as root"
        help
        exit 1
    fi
}

# Check if any options or arguments is specified
checkArgs() {
    if (("$#" == 0)); then
        help
        exit 0
    fi
}

# Parse options and arguments
parseOpts() {
    local ARGS

    ARGS=$(getopt \
        --longoptions "help,games-directory:,addons-directory:" \
        --options "hg:a:" \
        --name $'\033[01;31mERROR\033[0m' \
        -- "$@") || {
        printf "%s\n" ""
        >&2 help
        exit 1
    }

    eval set -- "$ARGS"

    while true; do
        case $1 in
        -h | --help)
            help
            exit 0
            ;;
        -g | --games-directory)
            GAMES="$2"
            shift 2
            ;;
        -a | --addons-directory)
            ADDONS="$2"
            shift 2
            ;;
        --)
            shift
            # Add all arguments ending with .pkg to array
            for ARG; do
                if [[ "$ARG" == *.pkg ]]; then
                    ENTRIES+=("$ARG")
                else
                    info "Skipping non .pkg file: $ARG"
                fi
            done
            break
            ;;
        *)
            shift
            ;;
        esac
    done

    # Exit the script if no .pkg files specified
    if ((${#ENTRIES[@]} == 0)); then
        error "No packages specified."
        printf "%s\n" ""
        help
        exit 1
    fi
}

checkDirectoryPermissions() {
    local directory="$1"

    if [[ -d "$directory" && -r "$directory" && -w "$directory" ]]; then
        return 0
    fi

    error "$directory is not a directory or your user doesn't have enough permissions."
    exit 1
}

installGame() {
    if [[ ! -x "$EXTRACTOR" ]]; then
        error "$EXTRACTOR is not found or can not be executed."
        exit 1
    fi

    for ENTRY in "${ENTRIES[@]}"; do
        # Input package
        local package="$ENTRY"
        # Output directory
        local destination="${GAMES:-$(dirname "$package")}"
        # Exit code
        local exitcode=0

        # Check package type
        set +e
        $EXTRACTOR "$package" --check-type &>/dev/null
        exitcode=$?
        set -e

        case $exitcode in
        101)
            if [[ -n $GAMES ]]; then
                checkDirectoryPermissions "$GAMES"
                destination="$GAMES"
            else
                error "Please specify games directory using --games-directory option"
                exit 1
            fi
            info "Base game detected. Installing to \"$destination\"."
            ;;
        102)
            if [[ -n $GAMES ]]; then
                checkDirectoryPermissions "$GAMES"
                destination="$GAMES"
            else
                error "Please specify games directory using --games-directory option"
                exit 1
            fi
            info "Game update detected. Installing to \"$destination\"."
            ;;
        103)
            if [[ -n $ADDONS ]]; then
                checkDirectoryPermissions "$ADDONS"
                destination="$ADDONS"
            else
                error "Please specify addons directory using --addons-directory option"
                exit 1
            fi
            info "DLC package detected. Installing to \"$destination\"."
            ;;
        0)
            error "Failed to install \"$package\": package is corrupted or invalid."
            exit 1
            ;;
        *)
            error "An unexpected error occurred while checking \"$package\". (code: $exitcode)."
            exit 1
            ;;
        esac

        info "Starting installation in..."
        local dots="..."
        for i in {1..3}; do
            info "${i}${dots:0:$i}"
            sleep 1
        done

        # Extract the package
        $EXTRACTOR "$package" "$destination"
    done
}

# Main function
main() {
    checkRoot
    checkArgs "$@"
    parseOpts "$@"
    installGame
    info "Successfully finished game installation!"
}

# Execute main function
main "$@"
